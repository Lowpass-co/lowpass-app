# ============================================
# LOWPASS — Environment Variables
#
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# File Storage (google_drive or s3)
STORAGE_PROVIDER=google_drive
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
# GOOGLE_SERVICE_ACCOUNT_KEY=path-to-service-account.json

# AWS S3 (uncomment when migrating from Google Drive)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=lowpass-files
# AWS_REGION=eu-west-2

# Spotify (artist search + images; create app at developer.spotify.com)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# AI (Claude API for document extraction)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Email (Resend for notifications)
RESEND_API_KEY=your-resend-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
