# ============================================
# LOWPASS — Environment Variables
#
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# File Storage (google_drive or s3)
STORAGE_PROVIDER=google_drive
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
# SERVICE_ACCOUNT_KEY_FILE=path-to-service-account.json

# AWS S3 (uncomment when migrating from Google Drive)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=lowpass-files
# AWS_REGION=eu-west-2

# Spotify (artist search + images; create app at developer.spotify.com)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# AI (Claude API for document extraction)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Email (Resend for notifications)
RESEND_API_KEY=your-resend-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps / Places (autocomplete, geocode, directions, airport pick).
# Create an API key at console.cloud.google.com with these APIs enabled:
#   Places API, Geocoding API, Directions API, Maps JavaScript API.
GOOGLE_PLACES_API_KEY=your-google-maps-api-key

# Google Programmable Search (powers "Auto Images" in Rental Inventory).
# 1. Create a Programmable Search Engine at programmablesearchengine.google.com
#    — search the whole web, turn ON Image search. Copy its "Search engine ID".
# 2. In Google Cloud Console, enable "Custom Search API" on a project, then
#    either reuse GOOGLE_PLACES_API_KEY above (must have Custom Search API
#    enabled on the same key) OR create a dedicated key here.
# 3. Restart `npm run dev` after setting these.
GOOGLE_CSE_CX=your-programmable-search-engine-id
# GOOGLE_CUSTOM_SEARCH_API_KEY=your-dedicated-cse-key  # optional; falls back to GOOGLE_PLACES_API_KEY

# Google Docs export (for rider/pack Google Doc export)
# Used by /api/rider-packs/[id]/export/google-doc.
# Service account JSON -> these two values + the client_email.
# Private key should be the full -----BEGIN PRIVATE KEY-----...----- block.
# In Vercel or any env that can't hold real newlines, use literal \n escapes;
# src/lib/google/auth.ts un-escapes them at runtime.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
